import React, { useState, useEffect, useMemo } from 'react';
import { signInAnonymously, onAuthStateChanged } from 'firebase/auth';
import { collection, onSnapshot, doc, setDoc, deleteDoc, updateDoc } from 'firebase/firestore';

// --- FIREBASE INITIALIZATION ---
// Config now lives in src/firebase.ts and comes from Vite env vars
// (VITE_FIREBASE_*) instead of the Gemini-sandbox-only globals
// (__firebase_config / __app_id) this file originally used.
import { auth, db, appId, isFirebaseConfigured, firebaseInitError } from './firebase';

// --- ICONS (Inline SVGs to prevent missing import crashes) ---
const Icons = {
  User: () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>,
  Lock: () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>,
  LogOut: () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>,
  Box: () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>,
  Users: () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>,
  ClipboardList: () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>,
  AlertTriangle: () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>,
  Upload: () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>,
  Download: () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>,
  Plus: () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 4v16m8-8H4"></path></svg>,
  X: () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M6 18L18 6M6 6l12 12"></path></svg>,
  Check: () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"></path></svg>,
  Search: () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>,
  Settings: () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>,
  Camera: () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>,
  List: () => <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
};

const Toast = ({ message, type, onClose }) => {
  useEffect(() => {
    if (message) {
      const timer = setTimeout(() => onClose(), 3000);
      return () => clearTimeout(timer);
    }
  }, [message, onClose]);

  if (!message) return null;

  return (
    <div className={`fixed top-4 right-4 z-50 p-4 rounded-md shadow-lg flex items-center space-x-2 text-white ${type === 'error' ? 'bg-red-600' : 'bg-green-600'}`}>
      {type === 'error' ? <Icons.AlertTriangle /> : <Icons.Check />}
      <span>{message}</span>
      <button onClick={onClose} className="ml-4 hover:opacity-75"><Icons.X /></button>
    </div>
  );
};

export default function App() {
  const [firebaseUser, setFirebaseUser] = useState(null);
  const [lunaUser, setLunaUser] = useState(null); // The custom LUNA logged-in user
  
  // Data States
  const [users, setUsers] = useState([]);
  const [components, setComponents] = useState([]);
  const [transactions, setTransactions] = useState([]);
  
  // App States
  const [loading, setLoading] = useState(true);
  const [toast, setToast] = useState({ message: '', type: '' });
  const [qrLoaded, setQrLoaded] = useState(false);

  const showToast = (message, type = 'success') => setToast({ message, type });

  useEffect(() => {
    if (!isFirebaseConfigured || !auth) return;

    // Standalone deployments use normal Firebase Authentication.
    // (The original Gemini sandbox could supply a custom
    // __initial_auth_token; that global doesn't exist here, so this
    // now always falls through to the anonymous sign-in path the
    // original code already had.)
    const initAuth = async () => {
      try {
        await signInAnonymously(auth);
      } catch (err) {
        console.error("Auth error:", err);
      }
    };
    initAuth();

    const unsubscribe = onAuthStateChanged(auth, (u) => {
      setFirebaseUser(u);
    });

    // Load QR Script
    const script = document.createElement('script');
    script.src = "https://unpkg.com/html5-qrcode";
    script.async = true;
    script.onload = () => setQrLoaded(true);
    script.onerror = () => console.error("Failed to load html5-qrcode script.");
    document.body.appendChild(script);

    return () => {
      unsubscribe();
      if(document.body.contains(script)) document.body.removeChild(script);
    };
  }, []);

  useEffect(() => {
    if (!isFirebaseConfigured || !db) return;
    if (!firebaseUser) return;

    const collections = ['luna_users', 'luna_components', 'luna_transactions'];
    const unsubscribes = [];

    collections.forEach(colName => {
      const colRef = collection(db, 'artifacts', appId, 'public', 'data', colName);
      const unsub = onSnapshot(colRef, (snapshot) => {
        const data = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
        if (colName === 'luna_users') {
          setUsers(data);
          // If a LUNA user is currently logged in, refresh their specific data just in case it updated
          setLunaUser(prev => prev ? data.find(u => u.id === prev.id) || null : null);
        }
        if (colName === 'luna_components') setComponents(data);
        if (colName === 'luna_transactions') setTransactions(data);
        setLoading(false);
      }, (error) => {
        console.error(`Error fetching ${colName}:`, error);
      });
      unsubscribes.push(unsub);
    });

    return () => unsubscribes.forEach(unsub => unsub());
  }, [firebaseUser]);

  const handleLogout = () => setLunaUser(null);

  if (!isFirebaseConfigured || firebaseInitError) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gray-50 p-6">
        <div className="max-w-md w-full bg-white border border-red-200 rounded-xl shadow-sm p-6 text-center">
          <div className="w-12 h-12 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-4">
            <Icons.AlertTriangle />
          </div>
          <h1 className="text-lg font-bold text-gray-900 mb-2">Configuration Error</h1>
          <p className="text-sm text-gray-600">
            {firebaseInitError || 'Firebase configuration is missing. Please set the VITE_FIREBASE_* environment variables (see .env.example / README.md).'}
          </p>
        </div>
      </div>
    );
  }

  if (loading) {
    return <div className="min-h-screen flex items-center justify-center bg-gray-50"><div className="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600"></div></div>;
  }

  return (
    <div className="min-h-screen bg-gray-50 font-sans text-gray-800">
      <Toast message={toast.message} type={toast.type} onClose={() => setToast({ message: '', type: '' })} />
      {!lunaUser ? (
        <LoginScreen users={users} setLunaUser={setLunaUser} showToast={showToast} db={db} appId={appId} />
      ) : lunaUser.role === 'admin' ? (
        <AdminDashboard 
          user={lunaUser} users={users} components={components} transactions={transactions} 
          onLogout={handleLogout} db={db} appId={appId} showToast={showToast} 
        />
      ) : (
        <StudentDashboard 
          user={lunaUser} components={components} transactions={transactions} 
          onLogout={handleLogout} db={db} appId={appId} showToast={showToast} qrLoaded={qrLoaded}
        />
      )}
    </div>
  );
}

function LoginScreen({ users, setLunaUser, showToast, db, appId }) {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [isForgot, setIsForgot] = useState(false);
  const [resetStudentId, setResetStudentId] = useState('');
  const [newPassword, setNewPassword] = useState('');

  const handleLogin = (e) => {
    e.preventDefault();
    
    // System admin override - now ALWAYS active regardless of users.length
    if (email === 'admin' && password === 'admin') {
      setLunaUser({ id: 'sysadmin', role: 'admin', name: 'System Admin' });
      return;
    }

    const matchedUser = users.find(u => u.email.toLowerCase() === email.toLowerCase() && u.password === password);
    
    if (matchedUser) {
      if (!matchedUser.isActive) {
        showToast("Your account is deactivated. Contact Administrator.", "error");
      } else {
        setLunaUser(matchedUser);
        showToast(`Welcome back, ${matchedUser.name}!`);
      }
    } else {
      showToast("Invalid credentials.", "error");
    }
  };

  const handleResetPassword = async (e) => {
    e.preventDefault();
    const matchedUser = users.find(u => u.email.toLowerCase() === email.toLowerCase() && u.studentId === resetStudentId);
    
    if (matchedUser) {
      try {
        const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'luna_users', matchedUser.id);
        await updateDoc(docRef, { password: newPassword });
        showToast("Password updated successfully! You can now log in.");
        setIsForgot(false);
        setPassword('');
        setNewPassword('');
        setResetStudentId('');
      } catch (err) {
        showToast("Failed to update password.", "error");
      }
    } else {
      showToast("No account matches that Email and Student ID.", "error");
    }
  };

  return (
    <div className="flex items-center justify-center min-h-screen p-4 bg-gradient-to-br from-indigo-50 to-blue-100">
      <div className="bg-white p-8 rounded-xl shadow-xl w-full max-w-md border border-gray-100">
        <div className="text-center mb-8">
          <div className="w-16 h-16 bg-indigo-600 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg">
             <Icons.Box />
          </div>
          <h1 className="text-3xl font-bold text-gray-900 tracking-tight">LUNA System</h1>
          <p className="text-sm text-gray-500 mt-2">Laboratory User Navigation Assistant</p>
        </div>

        {!isForgot ? (
          <form onSubmit={handleLogin} className="space-y-5">
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Email or User ID</label>
              <div className="relative">
                <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400"><Icons.User /></div>
                <input type="text" required value={email} onChange={(e) => setEmail(e.target.value)}
                  className="pl-10 w-full border border-gray-300 rounded-lg py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all" 
                  placeholder="Enter your email" />
              </div>
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Password</label>
              <div className="relative">
                <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400"><Icons.Lock /></div>
                <input type="password" required value={password} onChange={(e) => setPassword(e.target.value)}
                  className="pl-10 w-full border border-gray-300 rounded-lg py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all" 
                  placeholder="••••••••" />
              </div>
            </div>
            <div className="flex items-center justify-between">
              <button type="button" onClick={() => setIsForgot(true)} className="text-sm text-indigo-600 hover:text-indigo-500 font-medium">
                Forgot Password?
              </button>
            </div>
            <button type="submit" className="w-full bg-indigo-600 text-white font-semibold py-2.5 rounded-lg hover:bg-indigo-700 transition-colors shadow-md flex justify-center items-center">
              Login to Portal
            </button>
          </form>
        ) : (
          <form onSubmit={handleResetPassword} className="space-y-5">
            <h2 className="text-lg font-semibold text-gray-900 mb-2">Reset Password</h2>
            <p className="text-sm text-gray-500 mb-4">Enter your registered Email and Student ID to reset your password.</p>
            
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Email</label>
              <input type="email" required value={email} onChange={(e) => setEmail(e.target.value)}
                  className="w-full border border-gray-300 rounded-lg py-2 px-3 focus:ring-indigo-500 outline-none" placeholder="Registered Email" />
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Student ID</label>
              <input type="text" required value={resetStudentId} onChange={(e) => setResetStudentId(e.target.value)}
                  className="w-full border border-gray-300 rounded-lg py-2 px-3 focus:ring-indigo-500 outline-none" placeholder="Your Student ID" />
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">New Password</label>
              <input type="password" required value={newPassword} onChange={(e) => setNewPassword(e.target.value)}
                  className="w-full border border-gray-300 rounded-lg py-2 px-3 focus:ring-indigo-500 outline-none" placeholder="••••••••" />
            </div>
            
            <div className="flex space-x-3 pt-2">
              <button type="button" onClick={() => setIsForgot(false)} className="flex-1 bg-gray-200 text-gray-800 font-semibold py-2.5 rounded-lg hover:bg-gray-300 transition-colors">
                Cancel
              </button>
              <button type="submit" className="flex-1 bg-indigo-600 text-white font-semibold py-2.5 rounded-lg hover:bg-indigo-700 transition-colors shadow-md">
                Reset Password
              </button>
            </div>
          </form>
        )}
      </div>
    </div>
  );
}

function AdminDashboard({ user, users, components, transactions, onLogout, db, appId, showToast }) {
  const [activeTab, setActiveTab] = useState('overview');

  const stats = useMemo(() => {
    const totalComps = components.length;
    const lowStock = components.filter(c => Number(c.availableQty) <= Number(c.minStock)).length;
    const activeTrans = transactions.filter(t => t.status === 'ISSUED' || t.status === 'PARTIALLY RETURNED').length;
    const totalStudents = users.filter(u => u.role === 'student').length;
    return { totalComps, lowStock, activeTrans, totalStudents };
  }, [components, transactions, users]);

  const navItems = [
    { id: 'overview', label: 'Overview', icon: <Icons.Box /> },
    { id: 'inventory', label: 'Inventory', icon: <Icons.List /> },
    { id: 'students', label: 'Students', icon: <Icons.Users /> },
    { id: 'transactions', label: 'Transactions', icon: <Icons.ClipboardList /> },
    { id: 'issued', label: 'Currently Issued', icon: <Icons.Check /> },
  ];

  return (
    <div className="flex h-screen overflow-hidden bg-gray-100">
      {/* Sidebar */}
      <div className="w-64 bg-slate-900 text-white flex flex-col shadow-xl z-10 hidden md:flex">
        <div className="p-6 border-b border-slate-800 flex items-center space-x-3">
          <div className="w-8 h-8 bg-indigo-500 rounded flex items-center justify-center"><Icons.Box /></div>
          <span className="text-xl font-bold tracking-wider">LUNA Admin</span>
        </div>
        <nav className="flex-1 overflow-y-auto py-4">
          {navItems.map(item => (
            <button key={item.id} onClick={() => setActiveTab(item.id)}
              className={`w-full flex items-center space-x-3 px-6 py-3 text-sm transition-colors ${activeTab === item.id ? 'bg-indigo-600 text-white border-l-4 border-indigo-400' : 'text-slate-400 hover:bg-slate-800 hover:text-white'}`}>
              {item.icon} <span>{item.label}</span>
            </button>
          ))}
        </nav>
        <div className="p-4 border-t border-slate-800">
          <div className="mb-4 px-2">
            <p className="text-sm font-medium text-white">{user.name}</p>
            <p className="text-xs text-slate-400">Administrator</p>
          </div>
          <button onClick={onLogout} className="w-full flex items-center justify-center space-x-2 bg-slate-800 hover:bg-red-600 text-white py-2 rounded-md transition-colors text-sm">
            <Icons.LogOut /> <span>Logout</span>
          </button>
        </div>
      </div>

      {/* Main Content */}
      <div className="flex-1 flex flex-col overflow-hidden">
        {/* Mobile Header */}
        <header className="md:hidden bg-white shadow-sm p-4 flex justify-between items-center">
          <span className="font-bold text-lg text-indigo-700">LUNA Admin</span>
          <select value={activeTab} onChange={(e) => setActiveTab(e.target.value)} className="bg-gray-100 border-none rounded p-2 text-sm outline-none">
            {navItems.map(item => <option key={item.id} value={item.id}>{item.label}</option>)}
          </select>
        </header>

        <main className="flex-1 overflow-x-hidden overflow-y-auto bg-gray-50 p-6">
          {activeTab === 'overview' && <AdminOverview stats={stats} components={components} />}
          {activeTab === 'inventory' && <AdminInventory components={components} db={db} appId={appId} showToast={showToast} />}
          {activeTab === 'students' && <AdminStudents users={users} db={db} appId={appId} showToast={showToast} />}
          {activeTab === 'transactions' && <AdminTransactions transactions={transactions} components={components} users={users} />}
          {activeTab === 'issued' && <AdminIssued transactions={transactions} components={components} users={users} />}
        </main>
      </div>
    </div>
  );
}

function AdminOverview({ stats, components }) {
  const lowStockItems = components.filter(c => Number(c.availableQty) <= Number(c.minStock));

  return (
    <div className="space-y-6">
      <h1 className="text-2xl font-bold text-gray-900">Dashboard Overview</h1>
      
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <StatCard title="Total Components" value={stats.totalComps} icon={<Icons.Box />} color="bg-blue-500" />
        <StatCard title="Low Stock Alerts" value={stats.lowStock} icon={<Icons.AlertTriangle />} color={stats.lowStock > 0 ? "bg-red-500" : "bg-green-500"} />
        <StatCard title="Active Transactions" value={stats.activeTrans} icon={<Icons.ClipboardList />} color="bg-orange-500" />
        <StatCard title="Registered Students" value={stats.totalStudents} icon={<Icons.Users />} color="bg-indigo-500" />
      </div>

      {lowStockItems.length > 0 && (
        <div className="bg-white rounded-xl shadow-sm border border-red-200 overflow-hidden mt-8">
          <div className="bg-red-50 border-b border-red-200 p-4 flex items-center space-x-2 text-red-700">
            <Icons.AlertTriangle />
            <h2 className="font-semibold text-lg">Attention Required: Low Stock</h2>
          </div>
          <div className="p-0">
            <table className="min-w-full divide-y divide-gray-200">
              <thead className="bg-gray-50">
                <tr>
                  <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Item</th>
                  <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Location</th>
                  <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Available / Min</th>
                </tr>
              </thead>
              <tbody className="bg-white divide-y divide-gray-200">
                {lowStockItems.map(item => (
                  <tr key={item.id}>
                    <td className="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{item.name} <span className="text-xs text-gray-500 block">{item.id}</span></td>
                    <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{item.drawer}</td>
                    <td className="px-6 py-4 whitespace-nowrap text-sm">
                      <span className="text-red-600 font-bold">{item.availableQty}</span> <span className="text-gray-400">/ {item.minStock}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </div>
  );
}

function StatCard({ title, value, icon, color }) {
  return (
    <div className="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex items-center space-x-4">
      <div className={`w-12 h-12 rounded-full flex items-center justify-center text-white ${color}`}>
        {icon}
      </div>
      <div>
        <p className="text-sm font-medium text-gray-500">{title}</p>
        <p className="text-2xl font-bold text-gray-900">{value}</p>
      </div>
    </div>
  );
}

function AdminStudents({ users, db, appId, showToast }) {
  const [showForm, setShowForm] = useState(false);
  const [formData, setFormData] = useState({ name: '', studentId: '', email: '', password: '', isActive: true });
  const [searchTerm, setSearchTerm] = useState('');
  const students = users.filter(u => u.role === 'student');
  const filteredStudents = students.filter(s => s.name.toLowerCase().includes(searchTerm.toLowerCase()) || s.studentId.toLowerCase().includes(searchTerm.toLowerCase()));

  const handleSave = async (e) => {
    e.preventDefault();
    try {
      const id = formData.id || `STU-${Date.now()}`;
      const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'luna_users', id);
      await setDoc(docRef, { ...formData, id, role: 'student', createdAt: new Date().toISOString() }, { merge: true });
      showToast(formData.id ? "Student updated." : "Student registered successfully.");
      setShowForm(false);
    } catch (err) {
      showToast("Error saving student.", "error");
    }
  };

  const handleToggleStatus = async (student) => {
    try {
      const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'luna_users', student.id);
      await updateDoc(docRef, { isActive: !student.isActive });
      showToast(`Student ${!student.isActive ? 'activated' : 'deactivated'}.`);
    } catch (err) {
      showToast("Error updating status.", "error");
    }
  };

  const handleCsvImport = (e) => {
    const file = e.target.files[0];
    if (!file) return;

    if (!file.name.toLowerCase().endsWith('.csv')) {
      showToast("Please select a valid .csv file.", "error");
      e.target.value = null; // reset input
      return;
    }

    const reader = new FileReader();
    reader.onload = async (event) => {
      try {
        const text = event.target.result;
        const lines = text.split('\n');
        let count = 0;
        
        // Skip header line (assuming first line is headers: Name, StudentID, Email, Password)
        for (let i = 1; i < lines.length; i++) {
          const line = lines[i].trim();
          if (!line) continue;
          
          const parts = line.split(',');
          if (parts.length >= 4) {
            const name = parts[0].trim();
            const studentId = parts[1].trim();
            const email = parts[2].trim();
            const password = parts[3].trim();
            
            const id = `STU-${Date.now()}-${i}`;
            const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'luna_users', id);
            await setDoc(docRef, {
              id, name, studentId, email, password, role: 'student', isActive: true, createdAt: new Date().toISOString()
            });
            count++;
          }
        }
        showToast(`Successfully imported ${count} students from CSV.`);
      } catch (err) {
        showToast("Error parsing CSV file.", "error");
      }
      e.target.value = null;
    };
    reader.readAsText(file);
  };

  return (
    <div>
      <div className="flex flex-col md:flex-row justify-between items-center mb-6 space-y-4 md:space-y-0">
        <h1 className="text-2xl font-semibold text-gray-900">Student Management</h1>
        <div className="flex space-x-3 w-full md:w-auto">
          <div className="relative">
            <input type="file" id="csv-upload" accept="*/*" onChange={handleCsvImport} className="hidden" />
            <label htmlFor="csv-upload" className="cursor-pointer bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-50 flex items-center shadow-sm h-full whitespace-nowrap">
              <div className="mr-2"><Icons.Upload /></div> Bulk CSV
            </label>
          </div>
          <button onClick={() => {setFormData({ name: '', studentId: '', email: '', password: '', isActive: true }); setShowForm(true);}} className="bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 flex items-center shadow-sm whitespace-nowrap">
            <Icons.Plus /> <span className="ml-2">Add Student</span>
          </button>
        </div>
      </div>

      {showForm && (
        <div className="mb-8 bg-white p-6 rounded-xl shadow-md border border-gray-200">
          <h2 className="text-lg font-medium mb-4">{formData.id ? 'Edit Student' : 'New Student Registration'}</h2>
          <form onSubmit={handleSave} className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <input type="text" placeholder="Full Name" required value={formData.name} onChange={e => setFormData({...formData, name: e.target.value})} className="border p-2 rounded outline-none focus:ring-2 focus:ring-indigo-500" />
            <input type="text" placeholder="Student ID (College ID)" required value={formData.studentId} onChange={e => setFormData({...formData, studentId: e.target.value})} className="border p-2 rounded outline-none focus:ring-2 focus:ring-indigo-500" />
            <input type="email" placeholder="Email Address" required value={formData.email} onChange={e => setFormData({...formData, email: e.target.value})} className="border p-2 rounded outline-none focus:ring-2 focus:ring-indigo-500" />
            <input type="text" placeholder="Login Password" required value={formData.password} onChange={e => setFormData({...formData, password: e.target.value})} className="border p-2 rounded outline-none focus:ring-2 focus:ring-indigo-500" />
            <div className="md:col-span-2 flex justify-end space-x-3 mt-2">
              <button type="button" onClick={() => setShowForm(false)} className="px-4 py-2 text-gray-600 hover:text-gray-900 font-medium">Cancel</button>
              <button type="submit" className="px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700 font-medium">Save Student</button>
            </div>
          </form>
        </div>
      )}

      <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div className="p-4 border-b border-gray-200 flex justify-between items-center bg-gray-50">
          <div className="relative w-full max-w-sm">
            <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400"><Icons.Search /></div>
            <input type="text" placeholder="Search students..." value={searchTerm} onChange={e => setSearchTerm(e.target.value)} className="pl-10 w-full border border-gray-300 rounded-md py-1.5 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm" />
          </div>
        </div>
        <div className="overflow-x-auto">
          <table className="min-w-full divide-y divide-gray-200">
            <thead className="bg-gray-50">
              <tr>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Student</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID / Email</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody className="bg-white divide-y divide-gray-200">
              {filteredStudents.map(student => (
                <tr key={student.id} className="hover:bg-gray-50">
                  <td className="px-6 py-4 whitespace-nowrap">
                    <div className="text-sm font-medium text-gray-900">{student.name}</div>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <div className="text-sm text-gray-900">{student.studentId}</div>
                    <div className="text-xs text-gray-500">{student.email}</div>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${student.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`}>
                      {student.isActive ? 'Active' : 'Inactive'}
                    </span>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <button onClick={() => {setFormData(student); setShowForm(true);}} className="text-indigo-600 hover:text-indigo-900 mr-4">Edit</button>
                    <button onClick={() => handleToggleStatus(student)} className={`${student.isActive ? 'text-red-600 hover:text-red-900' : 'text-green-600 hover:text-green-900'}`}>
                      {student.isActive ? 'Deactivate' : 'Activate'}
                    </button>
                  </td>
                </tr>
              ))}
              {filteredStudents.length === 0 && (
                 <tr><td colSpan="4" className="px-6 py-8 text-center text-gray-500">No students found.</td></tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}

function AdminInventory({ components, db, appId, showToast }) {
  const [showForm, setShowForm] = useState(false);
  const [formData, setFormData] = useState({ id: '', name: '', category: '', description: '', totalQty: 0, minStock: 0, drawer: '' });
  const [searchTerm, setSearchTerm] = useState('');

  const filteredComponents = components.filter(c => c.name.toLowerCase().includes(searchTerm.toLowerCase()) || c.id.toLowerCase().includes(searchTerm.toLowerCase()));

  const handleSave = async (e) => {
    e.preventDefault();
    try {
      const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'luna_components', formData.id);
      const isNew = !components.find(c => c.id === formData.id);
      const dataToSave = { 
        ...formData, 
        totalQty: Number(formData.totalQty), 
        minStock: Number(formData.minStock),
        availableQty: isNew ? Number(formData.totalQty) : Number(formData.availableQty || formData.totalQty)
      };
      await setDoc(docRef, dataToSave, { merge: true });
      showToast("Component saved successfully.");
      setShowForm(false);
    } catch (err) {
      showToast("Error saving component.", "error");
    }
  };

  const exportToCsv = () => {
    const headers = ['Component ID', 'Name', 'Category', 'Total Qty', 'Available Qty', 'Min Stock', 'Drawer Location', 'Status'];
    const rows = components.map(c => [
      c.id, `"${c.name}"`, c.category, c.totalQty, c.availableQty, c.minStock, c.drawer, (c.availableQty <= c.minStock ? 'LOW STOCK' : 'AVAILABLE')
    ]);
    const csvContent = "data:text/csv;charset=utf-8," + [headers.join(','), ...rows.map(e => e.join(','))].join("\n");
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement("a");
    link.setAttribute("href", encodedUri);
    link.setAttribute("download", `luna_inventory_${new Date().toISOString().split('T')[0]}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  return (
    <div>
      <div className="flex flex-col md:flex-row justify-between items-center mb-6 space-y-4 md:space-y-0">
        <h1 className="text-2xl font-semibold text-gray-900">Inventory Management</h1>
        <div className="flex space-x-3 w-full md:w-auto">
           <button onClick={exportToCsv} className="bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-50 flex items-center shadow-sm">
            <Icons.Download /> <span className="ml-2 hidden md:inline">Export CSV</span>
          </button>
          <button onClick={() => {setFormData({ id: '', name: '', category: '', description: '', totalQty: 0, minStock: 0, drawer: '' }); setShowForm(true);}} className="bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 flex items-center shadow-sm whitespace-nowrap">
            <Icons.Plus /> <span className="ml-2">Add Component</span>
          </button>
        </div>
      </div>

      {showForm && (
        <div className="mb-8 bg-white p-6 rounded-xl shadow-md border border-gray-200">
          <h2 className="text-lg font-medium mb-4">Component Details</h2>
          <form onSubmit={handleSave} className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <input type="text" placeholder="Component ID (e.g. C001)" required value={formData.id} onChange={e => setFormData({...formData, id: e.target.value})} className="border p-2 rounded outline-none focus:ring-2 focus:ring-indigo-500" disabled={!!components.find(c=>c.id===formData.id)} />
            <input type="text" placeholder="Name (e.g. Resistor 1kΩ)" required value={formData.name} onChange={e => setFormData({...formData, name: e.target.value})} className="border p-2 rounded outline-none focus:ring-2 focus:ring-indigo-500 md:col-span-2" />
            <input type="text" placeholder="Category (e.g. Passives)" required value={formData.category} onChange={e => setFormData({...formData, category: e.target.value})} className="border p-2 rounded outline-none focus:ring-2 focus:ring-indigo-500" />
            <input type="number" placeholder="Total Quantity" required min="0" value={formData.totalQty} onChange={e => setFormData({...formData, totalQty: e.target.value})} className="border p-2 rounded outline-none focus:ring-2 focus:ring-indigo-500" />
            <input type="number" placeholder="Minimum Stock Alert" required min="0" value={formData.minStock} onChange={e => setFormData({...formData, minStock: e.target.value})} className="border p-2 rounded outline-none focus:ring-2 focus:ring-indigo-500" />
            <input type="text" placeholder="Drawer Location (e.g. D01)" required value={formData.drawer} onChange={e => setFormData({...formData, drawer: e.target.value})} className="border p-2 rounded outline-none focus:ring-2 focus:ring-indigo-500" />
            <input type="text" placeholder="Description/Specs (optional)" value={formData.description} onChange={e => setFormData({...formData, description: e.target.value})} className="border p-2 rounded outline-none focus:ring-2 focus:ring-indigo-500 md:col-span-2" />
            <div className="md:col-span-3 flex justify-end space-x-3 mt-2">
              <button type="button" onClick={() => setShowForm(false)} className="px-4 py-2 text-gray-600 hover:text-gray-900 font-medium">Cancel</button>
              <button type="submit" className="px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700 font-medium">Save Component</button>
            </div>
          </form>
        </div>
      )}

      <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div className="p-4 border-b border-gray-200 flex justify-between items-center bg-gray-50">
          <div className="relative w-full max-w-sm">
            <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400"><Icons.Search /></div>
            <input type="text" placeholder="Search inventory..." value={searchTerm} onChange={e => setSearchTerm(e.target.value)} className="pl-10 w-full border border-gray-300 rounded-md py-1.5 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm" />
          </div>
        </div>
        <div className="overflow-x-auto">
          <table className="min-w-full divide-y divide-gray-200">
            <thead className="bg-gray-50">
              <tr>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Component</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Location</th>
                <th className="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Stock (Avail / Total)</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Action</th>
              </tr>
            </thead>
            <tbody className="bg-white divide-y divide-gray-200">
              {filteredComponents.map(comp => (
                <tr key={comp.id} className="hover:bg-gray-50">
                  <td className="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{comp.id}</td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <div className="text-sm font-medium text-gray-900">{comp.name}</div>
                    <div className="text-xs text-gray-500">{comp.category}</div>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-mono">{comp.drawer}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-center text-sm">
                    <span className={`font-bold ${comp.availableQty <= comp.minStock ? 'text-red-600' : 'text-gray-900'}`}>{comp.availableQty}</span>
                    <span className="text-gray-400 mx-1">/</span>
                    <span className="text-gray-600">{comp.totalQty}</span>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                     {comp.availableQty === 0 ? <span className="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">OUT OF STOCK</span> :
                      comp.availableQty <= comp.minStock ? <span className="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">LOW STOCK</span> :
                      <span className="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">AVAILABLE</span>}
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <button onClick={() => {setFormData(comp); setShowForm(true);}} className="text-indigo-600 hover:text-indigo-900">Edit</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}

function AdminTransactions({ transactions }) {
  const sorted = [...transactions].sort((a,b) => new Date(b.issueTimestamp) - new Date(a.issueTimestamp));

  const exportToCsv = () => {
    const headers = ['Trans ID', 'Student', 'Student ID', 'Component', 'Comp ID', 'Qty Issued', 'Qty Returned', 'Issue Date', 'Return Date', 'Status'];
    const rows = sorted.map(t => [
      t.id, `"${t.studentName}"`, t.studentId, `"${t.componentName}"`, t.componentId, t.qtyIssued, t.qtyReturned, 
      new Date(t.issueTimestamp).toLocaleString(), t.returnTimestamp ? new Date(t.returnTimestamp).toLocaleString() : 'N/A', t.status
    ]);
    const csvContent = "data:text/csv;charset=utf-8," + [headers.join(','), ...rows.map(e => e.join(','))].join("\n");
    const link = document.createElement("a");
    link.href = encodeURI(csvContent);
    link.download = `luna_transactions_${new Date().toISOString().split('T')[0]}.csv`;
    link.click();
  };

  return (
    <div>
      <div className="flex justify-between items-center mb-6">
        <h1 className="text-2xl font-semibold text-gray-900">Transaction History</h1>
        <button onClick={exportToCsv} className="bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-50 flex items-center shadow-sm">
            <Icons.Download /> <span className="ml-2">Export CSV</span>
        </button>
      </div>
      <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div className="overflow-x-auto">
          <table className="min-w-full divide-y divide-gray-200">
            <thead className="bg-gray-50">
              <tr>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Student</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Component</th>
                <th className="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Qty (Iss/Ret)</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date / Time</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
              </tr>
            </thead>
            <tbody className="bg-white divide-y divide-gray-200">
              {sorted.map(t => (
                <tr key={t.id} className="hover:bg-gray-50">
                  <td className="px-6 py-4 whitespace-nowrap">
                    <div className="text-sm font-medium text-gray-900">{t.studentName}</div>
                    <div className="text-xs text-gray-500">{t.studentId}</div>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <div className="text-sm font-medium text-gray-900">{t.componentName}</div>
                    <div className="text-xs text-gray-500">{t.componentId}</div>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-center text-sm text-gray-700">
                    {t.qtyIssued} / {t.qtyReturned}
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <div><span className="font-semibold text-green-700">Iss:</span> {new Date(t.issueTimestamp).toLocaleString()}</div>
                    {t.returnTimestamp && <div><span className="font-semibold text-blue-700">Ret:</span> {new Date(t.returnTimestamp).toLocaleString()}</div>}
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <span className={`px-2 py-1 text-xs font-semibold rounded-full 
                      ${t.status === 'COMPLETED' ? 'bg-gray-100 text-gray-600' : 
                        t.status === 'PARTIALLY RETURNED' ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800'}`}>
                      {t.status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}

function AdminIssued({ transactions }) {
  const active = transactions.filter(t => t.status === 'ISSUED' || t.status === 'PARTIALLY RETURNED');
  
  return (
    <div>
      <h1 className="text-2xl font-semibold text-gray-900 mb-6">Currently Issued Components</h1>
      <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div className="overflow-x-auto">
          <table className="min-w-full divide-y divide-gray-200">
            <thead className="bg-gray-50">
              <tr>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Component</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Student</th>
                <th className="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Qty Holding</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Since</th>
              </tr>
            </thead>
            <tbody className="bg-white divide-y divide-gray-200">
              {active.map(t => (
                <tr key={t.id} className="hover:bg-gray-50">
                   <td className="px-6 py-4 whitespace-nowrap">
                    <div className="text-sm font-medium text-gray-900">{t.componentName}</div>
                    <div className="text-xs text-gray-500">{t.componentId}</div>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <div className="text-sm font-medium text-gray-900">{t.studentName}</div>
                    <div className="text-xs text-gray-500">{t.studentId}</div>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-center text-sm font-bold text-indigo-600">
                    {t.qtyIssued - t.qtyReturned}
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                     {new Date(t.issueTimestamp).toLocaleString()}
                  </td>
                </tr>
              ))}
              {active.length === 0 && <tr><td colSpan="4" className="px-6 py-8 text-center text-gray-500">All components are currently in inventory.</td></tr>}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}

function StudentDashboard({ user, components, transactions, onLogout, db, appId, showToast, qrLoaded }) {
  const [activeTab, setActiveTab] = useState('overview');
  
  const myActiveTransactions = transactions.filter(t => t.studentId === user.studentId && (t.status === 'ISSUED' || t.status === 'PARTIALLY RETURNED'));
  const componentsHeld = myActiveTransactions.reduce((acc, t) => acc + (t.qtyIssued - t.qtyReturned), 0);
  
  const navItems = [
    { id: 'overview', label: 'My Status', icon: <Icons.User /> },
    { id: 'issue', label: 'Issue Component', icon: <Icons.Box /> },
    { id: 'return', label: 'Return Component', icon: <Icons.Check /> },
    { id: 'history', label: 'Transaction History', icon: <Icons.ClipboardList /> },
    { id: 'profile', label: 'Profile Settings', icon: <Icons.Settings /> },
  ];

  return (
    <div className="flex flex-col h-screen bg-gray-50">
      {/* Top Navbar */}
      <header className="bg-white shadow-sm border-b border-gray-200">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex justify-between items-center h-16">
             <div className="flex items-center space-x-2">
                <div className="w-8 h-8 bg-indigo-600 rounded flex items-center justify-center text-white"><Icons.Box /></div>
                <span className="font-bold text-xl text-gray-900 tracking-tight">LUNA</span>
             </div>
             <div className="flex items-center space-x-4">
                <div className="text-right hidden sm:block">
                  <div className="text-sm font-medium text-gray-900">{user.name}</div>
                  <div className="text-xs text-gray-500">ID: {user.studentId}</div>
                </div>
                <button onClick={onLogout} className="p-2 text-gray-500 hover:text-red-600 transition-colors bg-gray-100 rounded-full hover:bg-red-50"><Icons.LogOut /></button>
             </div>
          </div>
        </div>
      </header>

      {/* Main Content Area */}
      <div className="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full flex flex-col md:flex-row gap-8 overflow-hidden">
        
        {/* Sidebar Nav (Desktop) */}
        <div className="w-full md:w-64 flex-shrink-0 flex flex-row md:flex-col overflow-x-auto md:overflow-visible gap-2 pb-2 md:pb-0 hide-scrollbar">
          {navItems.map(item => (
            <button key={item.id} onClick={() => setActiveTab(item.id)}
              className={`flex items-center space-x-3 px-4 py-3 rounded-lg text-sm font-medium transition-colors whitespace-nowrap ${activeTab === item.id ? 'bg-indigo-600 text-white shadow-md' : 'text-gray-600 bg-white border border-gray-200 hover:bg-gray-50 hover:text-gray-900'}`}>
              {item.icon} <span>{item.label}</span>
            </button>
          ))}
        </div>

        {/* Dynamic Content */}
        <div className="flex-1 bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden flex flex-col">
          <div className="p-6 md:p-8 overflow-y-auto flex-1">
            {activeTab === 'overview' && <StudentOverview myActiveTransactions={myActiveTransactions} componentsHeld={componentsHeld} />}
            {activeTab === 'issue' && <StudentIssue qrLoaded={qrLoaded} components={components} user={user} db={db} appId={appId} showToast={showToast} setActiveTab={setActiveTab} />}
            {activeTab === 'return' && <StudentReturn qrLoaded={qrLoaded} activeTransactions={myActiveTransactions} user={user} db={db} appId={appId} showToast={showToast} setActiveTab={setActiveTab} />}
            {activeTab === 'history' && <StudentHistory transactions={transactions.filter(t => t.studentId === user.studentId)} />}
            {activeTab === 'profile' && <StudentProfile user={user} db={db} appId={appId} showToast={showToast} />}
          </div>
        </div>
      </div>
    </div>
  );
}

function StudentOverview({ myActiveTransactions, componentsHeld }) {
  return (
    <div className="space-y-6">
      <h2 className="text-2xl font-bold text-gray-900 mb-6">My Current Status</h2>
      
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        <div className="bg-indigo-50 border border-indigo-100 p-6 rounded-xl flex items-center justify-between">
          <div>
            <p className="text-indigo-900 font-medium text-sm mb-1">Components Held</p>
            <p className="text-4xl font-bold text-indigo-700">{componentsHeld}</p>
          </div>
          <div className="w-12 h-12 bg-indigo-200 text-indigo-700 rounded-full flex items-center justify-center"><Icons.Box /></div>
        </div>
        <div className="bg-emerald-50 border border-emerald-100 p-6 rounded-xl flex items-center justify-between">
          <div>
            <p className="text-emerald-900 font-medium text-sm mb-1">Active Transactions</p>
            <p className="text-4xl font-bold text-emerald-700">{myActiveTransactions.length}</p>
          </div>
          <div className="w-12 h-12 bg-emerald-200 text-emerald-700 rounded-full flex items-center justify-center"><Icons.ClipboardList /></div>
        </div>
      </div>

      <h3 className="text-lg font-semibold text-gray-900 border-b pb-2">Currently Issued Items</h3>
      {myActiveTransactions.length === 0 ? (
        <div className="text-center py-10 bg-gray-50 rounded-lg border border-dashed border-gray-300 text-gray-500">
          You don't have any components currently issued.
        </div>
      ) : (
        <div className="space-y-4">
          {myActiveTransactions.map(t => (
            <div key={t.id} className="bg-white border border-gray-200 p-4 rounded-lg shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
              <div>
                <h4 className="font-bold text-gray-900">{t.componentName} <span className="text-xs font-normal text-gray-500 ml-2">ID: {t.componentId}</span></h4>
                <p className="text-sm text-gray-600 mt-1">Issued on: {new Date(t.issueTimestamp).toLocaleDateString()} at {new Date(t.issueTimestamp).toLocaleTimeString()}</p>
              </div>
              <div className="bg-gray-100 px-4 py-2 rounded-md flex items-center gap-3 w-full md:w-auto justify-between">
                 <span className="text-xs text-gray-500 uppercase tracking-wider font-semibold">Qty Holding</span>
                 <span className="text-xl font-bold text-indigo-700">{t.qtyIssued - t.qtyReturned}</span>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

function QrScanner({ onScan, buttonText }) {
  const [scanning, setScanning] = useState(false);
  
  useEffect(() => {
    let scanner = null;
    if (scanning) {
       try {
         scanner = new window.Html5QrcodeScanner("qr-reader", { fps: 10, qrbox: {width: 250, height: 250}, aspectRatio: 1.0 });
         scanner.render(
           (decodedText) => {
             if (scanner) {
               scanner.clear().catch(console.error);
             }
             setScanning(false);
             onScan(decodedText);
           },
           (err) => { /* ignore normal scanning errors */ }
         );
       } catch (e) {
         console.error("Scanner init error:", e);
       }
    }
    return () => {
      if (scanner) {
        scanner.clear().catch(e => console.log("Scanner cleanup", e));
      }
    };
  }, [scanning, onScan]);

  return (
    <div className="w-full flex flex-col items-center">
      {!scanning ? (
        <button onClick={() => setScanning(true)} className="bg-indigo-100 text-indigo-700 hover:bg-indigo-200 py-3 px-6 rounded-lg font-semibold flex items-center gap-2 shadow-sm transition-colors">
          <Icons.Camera /> Start QR Scanner
        </button>
      ) : (
        <div className="w-full max-w-sm rounded-lg overflow-hidden border-2 border-indigo-500 bg-black">
           <div id="qr-reader" className="w-full h-full text-white"></div>
           <button onClick={() => setScanning(false)} className="w-full bg-red-600 text-white py-2 font-medium hover:bg-red-700">Cancel Scan</button>
        </div>
      )}
    </div>
  );
}

function StudentIssue({ components, user, db, appId, showToast, setActiveTab, qrLoaded }) {
  const [step, setStep] = useState(1);
  const [manualId, setManualId] = useState('');
  const [searchTerm, setSearchTerm] = useState('');
  const [selectedComp, setSelectedComp] = useState(null);
  const [qty, setQty] = useState(1);

  const availableComponents = components.filter(c => c.availableQty > 0);
  const filtered = availableComponents.filter(c => c.name.toLowerCase().includes(searchTerm.toLowerCase()) || c.id.toLowerCase().includes(searchTerm.toLowerCase()));

  const handleScan = (data) => {
    if (data.trim().toLowerCase() === user.studentId.toLowerCase()) {
      showToast("Identity verified successfully!");
      setStep(2);
    } else {
      showToast("QR code does not match your registered Student ID.", "error");
    }
  };

  const submitIssue = async () => {
    if (qty > selectedComp.availableQty) {
      showToast("Requested quantity exceeds available stock.", "error");
      return;
    }
    try {
      const txId = `TX-${Date.now()}`;
      const txRef = doc(db, 'artifacts', appId, 'public', 'data', 'luna_transactions', txId);
      await setDoc(txRef, {
        id: txId,
        studentId: user.studentId,
        studentName: user.name,
        componentId: selectedComp.id,
        componentName: selectedComp.name,
        qtyIssued: Number(qty),
        qtyReturned: 0,
        issueTimestamp: new Date().toISOString(),
        returnTimestamp: null,
        status: 'ISSUED'
      });

      const compRef = doc(db, 'artifacts', appId, 'public', 'data', 'luna_components', selectedComp.id);
      await updateDoc(compRef, { availableQty: selectedComp.availableQty - Number(qty) });

      showToast(`Successfully issued ${qty}x ${selectedComp.name} from Drawer ${selectedComp.drawer}`);
      setActiveTab('overview');
    } catch (err) {
      showToast("Error processing transaction.", "error");
    }
  };

  if (step === 1) {
    return (
      <div className="flex flex-col items-center justify-center h-full py-10 space-y-8 max-w-md mx-auto text-center">
        <div className="w-20 h-20 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mb-2"><Icons.User /></div>
        <h2 className="text-2xl font-bold">Identity Verification</h2>
        <p className="text-gray-500">Please scan your registered Student ID QR code to access inventory.</p>
        
        {qrLoaded && <QrScanner onScan={handleScan} />}

        <div className="w-full border-t border-gray-200 relative mt-8">
           <span className="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 bg-white px-3 text-xs text-gray-400">OR ENTER MANUALLY</span>
        </div>

        <form onSubmit={e => { e.preventDefault(); handleScan(manualId); }} className="w-full flex space-x-2">
          <input type="text" placeholder="Enter your Student ID" required value={manualId} onChange={e => setManualId(e.target.value)} className="flex-1 border border-gray-300 rounded-lg px-4 py-2 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
          <button type="submit" className="bg-gray-800 text-white px-4 py-2 rounded-lg font-medium hover:bg-gray-900 transition-colors">Verify</button>
        </form>
      </div>
    );
  }

  if (selectedComp) {
    return (
      <div className="max-w-2xl mx-auto space-y-6">
        <button onClick={() => setSelectedComp(null)} className="text-sm font-medium text-indigo-600 hover:text-indigo-800 flex items-center mb-4">← Back to selection</button>
        <h2 className="text-2xl font-bold text-gray-900">Confirm Issue</h2>
        
        <div className="bg-gray-50 border border-gray-200 rounded-xl p-6 space-y-4">
           <div className="flex justify-between border-b pb-4">
              <div>
                <p className="text-sm text-gray-500 uppercase tracking-wide">Component</p>
                <p className="text-xl font-bold text-gray-900">{selectedComp.name}</p>
                <p className="text-sm text-gray-600">ID: {selectedComp.id}</p>
              </div>
              <div className="text-right">
                 <p className="text-sm text-gray-500 uppercase tracking-wide">Location</p>
                 <p className="text-2xl font-mono font-bold text-indigo-700 bg-indigo-100 px-3 py-1 rounded-md inline-block">{selectedComp.drawer}</p>
              </div>
           </div>
           
           <div>
             <p className="text-sm text-gray-500 mb-2">Quantity to Issue (Max: {selectedComp.availableQty})</p>
             <div className="flex items-center space-x-4">
                <input type="number" min="1" max={selectedComp.availableQty} value={qty} onChange={e => setQty(e.target.value)} className="w-24 text-center border-2 border-indigo-200 rounded-lg py-2 text-lg font-bold outline-none focus:border-indigo-600" />
                <button onClick={submitIssue} className="flex-1 bg-indigo-600 text-white py-3 rounded-lg font-bold hover:bg-indigo-700 shadow-md transition-colors text-lg">
                  Confirm Issue
                </button>
             </div>
           </div>
        </div>
      </div>
    );
  }

  return (
    <div className="space-y-6 flex flex-col h-full">
      <h2 className="text-2xl font-bold text-gray-900">Select Component to Issue</h2>
      <div className="relative">
        <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400"><Icons.Search /></div>
        <input type="text" placeholder="Search by name or ID..." value={searchTerm} onChange={e => setSearchTerm(e.target.value)} className="pl-10 w-full border border-gray-300 rounded-lg py-3 shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all" />
      </div>
      
      <div className="flex-1 overflow-y-auto pr-2 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 content-start">
        {filtered.map(comp => (
          <div key={comp.id} onClick={() => {setSelectedComp(comp); setQty(1);}} className="bg-white border border-gray-200 rounded-xl p-5 hover:border-indigo-500 hover:shadow-md cursor-pointer transition-all group flex flex-col">
            <div className="flex-1">
              <h3 className="font-bold text-lg text-gray-900 group-hover:text-indigo-700 mb-1">{comp.name}</h3>
              <p className="text-xs text-gray-500 mb-3">{comp.id} • {comp.category}</p>
            </div>
            <div className="flex justify-between items-end mt-4 pt-4 border-t border-gray-100">
               <div>
                  <p className="text-[10px] text-gray-400 uppercase font-bold tracking-wider">Available</p>
                  <p className="font-bold text-emerald-600 text-lg leading-none">{comp.availableQty}</p>
               </div>
               <div>
                  <p className="text-[10px] text-gray-400 uppercase font-bold tracking-wider text-right">Drawer</p>
                  <p className="font-mono text-gray-700 text-sm leading-none bg-gray-100 px-2 py-1 rounded">{comp.drawer}</p>
               </div>
            </div>
          </div>
        ))}
        {filtered.length === 0 && <div className="col-span-full py-10 text-center text-gray-500">No components available matching your search.</div>}
      </div>
    </div>
  );
}

function StudentReturn({ activeTransactions, user, db, appId, showToast, setActiveTab, qrLoaded }) {
  const [step, setStep] = useState(1);
  const [manualId, setManualId] = useState('');
  const [selectedTx, setSelectedTx] = useState(null);
  const [returnQty, setReturnQty] = useState(1);

  const handleScan = (data) => {
    if (data.trim().toLowerCase() === user.studentId.toLowerCase()) {
      showToast("Identity verified. Select item to return.");
      setStep(2);
    } else {
      showToast("QR code does not match your registered Student ID.", "error");
    }
  };

  const submitReturn = async () => {
    const qtyToReturnNum = Number(returnQty);
    const maxReturnable = selectedTx.qtyIssued - selectedTx.qtyReturned;
    
    if (qtyToReturnNum > maxReturnable) {
      showToast("Cannot return more than issued.", "error");
      return;
    }

    try {
      const newReturnedTotal = selectedTx.qtyReturned + qtyToReturnNum;
      const isComplete = newReturnedTotal >= selectedTx.qtyIssued;
      const newStatus = isComplete ? 'COMPLETED' : 'PARTIALLY RETURNED';

      const txRef = doc(db, 'artifacts', appId, 'public', 'data', 'luna_transactions', selectedTx.id);
      await updateDoc(txRef, {
        qtyReturned: newReturnedTotal,
        status: newStatus,
        returnTimestamp: isComplete ? new Date().toISOString() : selectedTx.returnTimestamp 
      });

      import('firebase/firestore').then(({ getDoc }) => {
          const compRef = doc(db, 'artifacts', appId, 'public', 'data', 'luna_components', selectedTx.componentId);
          getDoc(compRef).then(compSnap => {
              if (compSnap.exists()) {
                  const currentAvail = compSnap.data().availableQty || 0;
                  updateDoc(compRef, { availableQty: currentAvail + qtyToReturnNum });
              }
          });
      });

      showToast(`Successfully returned ${qtyToReturnNum}x ${selectedTx.componentName}`);
      setActiveTab('overview');
    } catch (err) {
      showToast("Error processing return.", "error");
    }
  };

  if (step === 1) {
    return (
      <div className="flex flex-col items-center justify-center h-full py-10 space-y-8 max-w-md mx-auto text-center">
        <div className="w-20 h-20 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mb-2"><Icons.Check /></div>
        <h2 className="text-2xl font-bold">Return Verification</h2>
        <p className="text-gray-500">Please scan your registered Student ID QR code to begin the return process.</p>
        
        {qrLoaded && <QrScanner onScan={handleScan} />}

        <div className="w-full border-t border-gray-200 relative mt-8">
           <span className="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 bg-white px-3 text-xs text-gray-400">OR ENTER MANUALLY</span>
        </div>

        <form onSubmit={e => { e.preventDefault(); handleScan(manualId); }} className="w-full flex space-x-2">
          <input type="text" placeholder="Enter your Student ID" required value={manualId} onChange={e => setManualId(e.target.value)} className="flex-1 border border-gray-300 rounded-lg px-4 py-2 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
          <button type="submit" className="bg-gray-800 text-white px-4 py-2 rounded-lg font-medium hover:bg-gray-900 transition-colors">Verify</button>
        </form>
      </div>
    );
  }

  if (selectedTx) {
    const maxReturnable = selectedTx.qtyIssued - selectedTx.qtyReturned;
    return (
      <div className="max-w-2xl mx-auto space-y-6">
        <button onClick={() => setSelectedTx(null)} className="text-sm font-medium text-indigo-600 hover:text-indigo-800 flex items-center mb-4">← Back to selection</button>
        <h2 className="text-2xl font-bold text-gray-900">Confirm Return</h2>
        
        <div className="bg-gray-50 border border-gray-200 rounded-xl p-6 space-y-4">
           <div className="flex justify-between border-b pb-4">
              <div>
                <p className="text-sm text-gray-500 uppercase tracking-wide">Component</p>
                <p className="text-xl font-bold text-gray-900">{selectedTx.componentName}</p>
                <p className="text-sm text-gray-600">Issued: {new Date(selectedTx.issueTimestamp).toLocaleDateString()}</p>
              </div>
           </div>
           
           <div>
             <p className="text-sm text-gray-500 mb-2">Quantity to Return (Max: {maxReturnable})</p>
             <div className="flex items-center space-x-4">
                <input type="number" min="1" max={maxReturnable} value={returnQty} onChange={e => setReturnQty(e.target.value)} className="w-24 text-center border-2 border-emerald-200 rounded-lg py-2 text-lg font-bold outline-none focus:border-emerald-600" />
                <button onClick={submitReturn} className="flex-1 bg-emerald-600 text-white py-3 rounded-lg font-bold hover:bg-emerald-700 shadow-md transition-colors text-lg">
                  Confirm Return
                </button>
             </div>
           </div>
        </div>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      <h2 className="text-2xl font-bold text-gray-900">Select Item to Return</h2>
      {activeTransactions.length === 0 ? (
        <div className="text-center py-10 bg-gray-50 rounded-lg border border-dashed border-gray-300 text-gray-500">
          You have no components to return.
        </div>
      ) : (
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          {activeTransactions.map(tx => {
            const holding = tx.qtyIssued - tx.qtyReturned;
            return (
              <div key={tx.id} onClick={() => {setSelectedTx(tx); setReturnQty(holding);}} className="bg-white border border-gray-200 rounded-xl p-5 hover:border-emerald-500 hover:shadow-md cursor-pointer transition-all flex justify-between items-center group">
                <div>
                  <h3 className="font-bold text-gray-900 group-hover:text-emerald-700">{tx.componentName}</h3>
                  <p className="text-xs text-gray-500 mt-1">Issued: {new Date(tx.issueTimestamp).toLocaleDateString()}</p>
                </div>
                <div className="bg-gray-100 px-3 py-2 rounded text-center">
                  <p className="text-[10px] text-gray-500 uppercase font-bold">Qty Holding</p>
                  <p className="font-bold text-lg text-emerald-700">{holding}</p>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  );
}

function StudentHistory({ transactions }) {
  const sorted = [...transactions].sort((a,b) => new Date(b.issueTimestamp) - new Date(a.issueTimestamp));
  
  return (
    <div className="space-y-6">
      <h2 className="text-2xl font-bold text-gray-900">My Transaction History</h2>
      {sorted.length === 0 ? (
         <div className="text-center py-10 text-gray-500">No transactions found.</div>
      ) : (
        <div className="bg-white border border-gray-200 rounded-xl overflow-hidden">
          <table className="min-w-full divide-y divide-gray-200">
            <thead className="bg-gray-50">
              <tr>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Component</th>
                <th className="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Qty</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Issue Date</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
              </tr>
            </thead>
            <tbody className="bg-white divide-y divide-gray-200">
              {sorted.map(t => (
                <tr key={t.id}>
                  <td className="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{t.componentName}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-center text-gray-700">{t.qtyIssued}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{new Date(t.issueTimestamp).toLocaleDateString()}</td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <span className={`px-2 py-1 text-xs font-semibold rounded-full 
                      ${t.status === 'COMPLETED' ? 'bg-gray-100 text-gray-600' : 
                        t.status === 'PARTIALLY RETURNED' ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800'}`}>
                      {t.status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  );
}

function StudentProfile({ user, db, appId, showToast }) {
  const [currentPwd, setCurrentPwd] = useState('');
  const [newPwd, setNewPwd] = useState('');

  const handleChangePassword = async (e) => {
    e.preventDefault();
    if (currentPwd !== user.password) {
      showToast("Current password is incorrect.", "error");
      return;
    }
    try {
      const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'luna_users', user.id);
      await updateDoc(docRef, { password: newPwd });
      showToast("Password updated successfully!");
      setCurrentPwd('');
      setNewPwd('');
    } catch (err) {
      showToast("Failed to update password.", "error");
    }
  };

  return (
    <div className="max-w-md mx-auto space-y-6 pt-6">
      <h2 className="text-2xl font-bold text-gray-900 text-center">Profile Settings</h2>
      
      <div className="bg-gray-50 p-6 rounded-xl border border-gray-200 text-center mb-8">
        <div className="w-20 h-20 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center mx-auto mb-4"><Icons.User /></div>
        <h3 className="text-xl font-bold text-gray-900">{user.name}</h3>
        <p className="text-sm text-gray-500">{user.email}</p>
        <p className="text-sm font-mono text-indigo-600 mt-2 bg-indigo-50 inline-block px-3 py-1 rounded">ID: {user.studentId}</p>
      </div>

      <form onSubmit={handleChangePassword} className="bg-white p-6 rounded-xl border border-gray-200 shadow-sm space-y-4">
        <h3 className="text-lg font-semibold text-gray-900 mb-2">Change Password</h3>
        <div>
          <label className="block text-sm font-medium text-gray-700 mb-1">Current Password</label>
          <input type="password" required value={currentPwd} onChange={e => setCurrentPwd(e.target.value)}
            className="w-full border border-gray-300 rounded-lg py-2 px-3 focus:ring-indigo-500 outline-none" />
        </div>
        <div>
          <label className="block text-sm font-medium text-gray-700 mb-1">New Password</label>
          <input type="password" required value={newPwd} onChange={e => setNewPwd(e.target.value)}
            className="w-full border border-gray-300 rounded-lg py-2 px-3 focus:ring-indigo-500 outline-none" />
        </div>
        <button type="submit" className="w-full bg-indigo-600 text-white font-semibold py-2.5 rounded-lg hover:bg-indigo-700 transition-colors mt-2">
          Update Password
        </button>
      </form>
    </div>
  );
}
